<Window x:Class="Restauracja.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logowanie i Rejestracja" Height="400" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel x:Name="LoginPanel" Visibility="Visible" VerticalAlignment="Center">
            <TextBlock Text="Logowanie" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBlock Text="Login:"/>
            <TextBox x:Name="txtLogin" Margin="0,5,0,10" Height="25"/>
            <TextBlock Text="Hasło:"/>
            <PasswordBox x:Name="txtPassword" Margin="0,5,0,20" Height="25"/>
            <Button Content="Zaloguj" Click="BtnLogin_Click" Background="DarkBlue" Foreground="White" Height="30"/>
            <Button Content="Zarejestruj nowe konto" Click="TogglePanels_Click" Background="Transparent" BorderThickness="0" Foreground="Blue" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel x:Name="RegisterPanel" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="Rejestracja Użytkownika" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            <TextBlock Text="Imię:"/>
            <TextBox x:Name="regImie" Margin="0,2,0,8"/>
            <TextBlock Text="Nazwisko:"/>
            <TextBox x:Name="regNazwisko" Margin="0,2,0,8"/>
            <TextBlock Text="Login:"/>
            <TextBox x:Name="regLogin" Margin="0,2,0,8"/>
            <TextBlock Text="Hasło:"/>
            <TextBox x:Name="regHaslo" Margin="0,2,0,8"/>
            <TextBlock Text="Rola:"/>
            <ComboBox x:Name="regRola" Margin="0,2,0,15">
                <ComboBoxItem Content="Kelner" IsSelected="True"/>
                <ComboBoxItem Content="Manager"/>
            </ComboBox>
            <Button Content="Zarejestruj" Click="BtnRegister_Click" Background="Green" Foreground="White"/>
            <Button Content="Powrót do logowania" Click="TogglePanels_Click" Background="Transparent" BorderThickness="0" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>