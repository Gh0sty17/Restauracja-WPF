<Window x:Class="Restauracja.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zamówienie" Height="600" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Kategorie i Menu" Grid.Column="0" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="comboCategories" SelectionChanged="ComboCategories_SelectionChanged" Margin="5" Height="30" VerticalContentAlignment="Center"/>

                <ListBox x:Name="listProducts" Grid.Row="1" MouseDoubleClick="ListProducts_MouseDoubleClick" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Nazwa}" FontSize="14" Margin="5,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>

        <GroupBox Header="Modyfikatory produktu (Double-click na produkt)" Grid.Column="1" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="listModifiers" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Nazwa}"/>
                                    <TextBlock Text="{Binding Doplata, StringFormat=' (+{0:F2} zł)'}" Foreground="Gray"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" Content="Dodaj do koszyka" Click="BtnAddToBasket_Click" Background="DarkGreen" Foreground="White" Height="30" Margin="5"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Koszyk" Grid.Column="2" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="listBasket" Margin="5">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Width="220">
                                <Button Content="X" Click="BtnRemoveItem_Click" DockPanel.Dock="Right" Background="DarkRed" Foreground="White" Padding="4,1"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="5,0">
                                    <Button Content="-" Click="BtnDec_Click" Padding="5,1"/>
                                    <TextBlock Text="{Binding Ilosc}" Margin="5,0" VerticalAlignment="Center"/>
                                    <Button Content="+" Click="BtnInc_Click" Padding="5,1"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Nazwa}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SumaPozycji, StringFormat={}{0:F2} zł}" Foreground="DimGray" DockPanel.Dock="Bottom"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Margin="5">
                    <TextBlock Text="Uwagi do kuchni:"/>
                    <TextBox x:Name="txtNotes" Height="40" TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Row="2" Margin="5" Background="#FAFAFA" Padding="5" BorderBrush="#E0E0E0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="lblNetto" Text="Suma Netto: 0,00 zł" Margin="0,2"/>
                        <TextBlock x:Name="lblVat" Text="VAT (8%): 0,00 zł" Margin="0,2"/>
                        <TextBlock x:Name="lblBrutto" Text="Suma Brutto: 0,00 zł" FontSize="15" FontWeight="Bold" Foreground="DarkBlue" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Zapisz sesję" Click="BtnSaveSession_Click" Background="Gray" Foreground="White"/>
                    <Button Content="Do Zapłaty" Click="BtnPay_Click" Grid.Column="1" Background="Navy" Foreground="White" FontWeight="Bold"/>
                </Grid>
            </Grid>
        </GroupBox>
    </Grid>
</Window>