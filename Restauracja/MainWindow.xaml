<Window x:Class="Restauracja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Restauracja"
        mc:Ignorable="d"
        Title="Sala Restauracyjna" Height="550" Width="800" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:StatusToColorConverter x:Key="StatusToColorConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Background="#F3F3F3" Margin="10">
            <TextBlock x:Name="lblUserInfo" Text="Zalogowany pracownik: " VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
            <Button x:Name="btnManagerPanel" Content="Panel Managera" DockPanel.Dock="Right" Click="BtnManagerPanel_Click" Background="Orange" Visibility="Collapsed"/>
        </DockPanel>

        <ItemsControl Grid.Row="1" x:Name="itemsTables" Margin="15">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Rows="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Margin="10" 
                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                            Click="Table_LPM_Click" MouseRightButtonDown="Table_PPM_MouseRightButtonDown">
                        <StackPanel>
                            <TextBlock Text="{Binding Number, StringFormat='Stolik {0}'}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>