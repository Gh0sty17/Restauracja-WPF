<Window x:Class="Restauracja.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel Administratora i Managera" Height="500" Width="750" WindowStartupLocation="CenterOwner">
    <TabControl Margin="10">
        <TabItem Header="Raporty">
            <StackPanel Margin="15">
                <TextBlock Text="Raport Dzienny" FontSize="18" FontWeight="Bold"/>
                <Separator Margin="0,5,0,15"/>
                <TextBlock x:Name="lblDailySum" Text="Suma dzisiejszych zamówień: 0.00 zł" FontSize="14" Margin="0,0,0,20"/>
                <Button Content="Eksportuj do CSV" Click="BtnExportCSV_Click" Background="DarkGreen" Foreground="White" Width="200" Height="30" HorizontalAlignment="Left"/>
            </StackPanel>
        </TabItem>

        <TabItem Header="Menu">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="listAllProducts" DisplayMemberPath="Nazwa" Margin="5"/>

                <StackPanel Grid.Column="1" Width="250" Margin="5">
                    <TextBlock Text="Kategoria:"/>
                    <ComboBox x:Name="cmbAddCat" Margin="0,2,0,10">
                        <ComboBoxItem Content="Przystawki" IsSelected="True"/>
                        <ComboBoxItem Content="Dania główne"/>
                        <ComboBoxItem Content="Napoje"/>
                        <ComboBoxItem Content="Desery"/>
                    </ComboBox>
                    <TextBlock Text="Nazwa produktu:"/>
                    <TextBox x:Name="txtAddName" Margin="0,2,0,10"/>
                    <TextBlock Text="Cena bazowa:"/>
                    <TextBox x:Name="txtAddPrice" Margin="0,2,0,15"/>
                    <Button Content="Dodaj Produkt" Click="BtnAddProduct_Click" Background="Blue" Foreground="White" Margin="0,0,0,5"/>
                    <Button Content="Usuń Produkt" Click="BtnDeleteProduct_Click" Background="Red" Foreground="White"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Pracownicy">
            <Grid Margin="10">
                <ListView x:Name="dgUsers">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Imię" DisplayMemberBinding="{Binding Imie}" Width="120"/>
                            <GridViewColumn Header="Nazwisko" DisplayMemberBinding="{Binding Nazwisko}" Width="120"/>
                            <GridViewColumn Header="Login" DisplayMemberBinding="{Binding Login}" Width="120"/>
                            <GridViewColumn Header="Rola" DisplayMemberBinding="{Binding Rola}" Width="100"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </TabItem>
    </TabControl>
</Window>